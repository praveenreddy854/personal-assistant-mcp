{
  "version": "2.0",
  "configurationProfile": "mcp-custom-handler",
  "extensions": { "http": { "routePrefix": "" } },
  "customHandler": {
    "description": { "defaultExecutablePath": "node", "arguments": ["dist/server.js"] },
    "port": "3000",
    "http": {
      "enableProxying": true,
      "defaultAuthorizationLevel": "anonymous",
      "routes": [{ "route": "{*route}" }]
    }
  },
  "logging": { "logLevel": { "default": "Warning", "Host.Results": "Warning" } }
}
