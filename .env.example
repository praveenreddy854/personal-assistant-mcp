NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000
COSMOS_ENDPOINT=http://127.0.0.1:8081
COSMOS_DATABASE=memory
COSMOS_CONTAINER=vaults
COSMOS_DIRECTORY_CONTAINER=identities
# Synthetic emulator-only key. Cloud uses managed identity and disables account-key authentication.
COSMOS_KEY=bG9jYWwtZW11bGF0b3ItdGVzdC1rZXk=
# development: local-only DEV_TOKEN (production refuses it)
# token: family tokens from `npm run add-member`, one shared vault
# oidc: OAuth sign-in, one private vault per identity
AUTH_MODE=development
DEV_TOKEN=replace-with-a-random-local-development-token-at-least-32-characters
AUTH_ISSUER=https://your-tenant.ciamlogin.com/your-tenant-id/v2.0
AUTH_AUDIENCE=your-mcp-api-application-client-id
AUTH_JWKS_URL=https://your-tenant.ciamlogin.com/your-tenant-id/discovery/v2.0/keys
AUTHORIZATION_SERVER=https://your-tenant.ciamlogin.com/your-tenant-id/v2.0
AUTH_SCOPE=memory.access
AUTH_REQUEST_SCOPE=https://your-memory-host.example/mcp/memory.access
SERVING_ENABLED=true
ALLOWED_ORIGINS=http://localhost:3000
# Use Azure-hosted deployments. Values are deployment names, not model aliases.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_CHAT_DEPLOYMENT=memory-reasoning
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=memory-embedding
EMBEDDING_VERSION=memory-embedding-v1
# Prefer managed identity in Azure. A local API key is optional.
AZURE_OPENAI_API_KEY=
